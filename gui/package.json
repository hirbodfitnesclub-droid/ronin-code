{
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^5.4.0"
  },
  "name": "ronin-code-gui",
  "private": true,
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite --port 5173",
    "preview": "vite preview --port 5173",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc -b",
    "lint": "eslint src",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"*.{json,mjs}\""
  },
  "type": "module",
  "version": "0.1.0"
}
