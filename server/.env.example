# ── Ronin Code server — environment ──────────────────────────────────────────
# Copy to .env and fill in. Real keys are set together with the owner at launch;
# NEVER commit a filled .env. Every name the code reads is listed here.

# Listener ports (user API + standalone admin app are separate servers)
PORT=7443
ADMIN_PORT=7444
HOST=127.0.0.1

# Database file (SQLite). Default: server/data/ronin.db
DB_PATH=

# Secret used to HMAC-hash OTP codes at rest (long random string). Required.
AUTH_SECRET=

# Phones (comma-separated, 09xxxxxxxxx) that are platform owners/admins (Liro semantics)
ADMIN_PHONES=

# ── SMS (Kavenegar) ──────────────────────────────────────────────────────────
# SMS_PROVIDER: kavenegar | console   (console = dev/tests, codes are logged + kept in an in-memory outbox)
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
# Verify Lookup template/pattern names as configured in the Kavenegar panel.
# token = the value substituted into the template's %token% placeholder.
KAVENEGAR_TEMPLATE=                 # OTP template (Liro env name)
KAVENEGAR_TEMPLATE_PACKAGE_ACTIVATED=
KAVENEGAR_TEMPLATE_EXPIRY_WARNING=
KAVENEGAR_TEMPLATE_EXPIRED=
KAVENEGAR_TEMPLATE_ORDER_REJECTED=
# Non-prod safety valve: if set, real SMS goes ONLY to these numbers (comma-separated)
SMS_ALLOWLIST=

# ── Shop / card-to-card (defaults; editable later from the admin panel) ──────
SHOP_CARD_NUMBER=
SHOP_CARD_HOLDER=
SHOP_CARD_BANK=

# ── Token economy defaults (admin-editable in settings) ─────────────────────
# Base (multiplier = 1) tokens granted per 1 USD of pack value
TOKENS_PER_USD=5000000

# ── Upstream LLM gateway (server-side only, never logged, never returned) ────
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=

# ── Limits ───────────────────────────────────────────────────────────────────
MAX_DEVICES=2
CHAT_RATE_PER_MIN=60
CHAT_MAX_CONCURRENT=3
