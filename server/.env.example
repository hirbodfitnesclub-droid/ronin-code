# ── Ronin Code server — environment ──────────────────────────────────────────
# Copy to .env and fill in. Real keys are set together with the owner at launch;
# NEVER commit a filled .env. Every name the code reads is listed here.

# Listener ports (user API + standalone admin app are separate servers)
PORT=7443
ADMIN_PORT=7444
HOST=127.0.0.1
# Set to 1 when the admin panel is served over HTTPS (adds Secure to the admin cookie)
COOKIE_SECURE=0

# ── Database + Supabase Auth (Postgres layer) ────────────────────────────────
# Postgres connection string used by BOTH apps (service role: bypasses RLS —
# the API layer, not Postgres, authorizes callers). On Supabase Cloud this is
# the project's service-role connection string from the dashboard.
DATABASE_URL=
# Base URL of the Supabase Auth (GoTrue) service — the identity/session engine.
SUPABASE_AUTH_URL=
# Anon (publishable) key of the project. Part of the stack contract; the
# service talks to GoTrue with it when present.
SUPABASE_ANON_KEY=
# Project JWT secret — lets the server verify access tokens locally (HS256)
# instead of a GoTrue round-trip per request. Strongly recommended.
SUPABASE_JWT_SECRET=
# Standard Webhooks secret shared with the GoTrue "Send SMS" hook
# (format: v1,whsec_<base64>). Must match GOTRUE_HOOK_SEND_SMS_SECRETS on the
# Auth server; the hook endpoint is POST /hooks/send-sms on the user API.
SUPABASE_AUTH_HOOK_SEND_SMS_SECRET=
# User OTP validity window in seconds — MUST match the Auth server's OTP
# expiry (GOTRUE_SMS_OTP_EXP) so the brute-force guard window lines up.
OTP_TTL_SECONDS=300

# Secret used to HMAC-hash ADMIN-login OTP codes at rest (long random string).
# Required. (End-user OTPs are owned by Supabase Auth; admin OTP stays ours.)
AUTH_SECRET=

# ── Receipt storage (card-to-card claim photos, Supabase Storage) ───────────
# Project base URL + service-role key: receipts are uploaded to the PRIVATE
# bucket `receipts` and admins receive short-lived signed URLs. Both are
# required in production; when unset (local dev/tests) receipts are stored
# as files under RECEIPTS_DIR with the same object keys instead.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RECEIPTS_DIR=
# Upload cap per receipt image (bytes) and signed-URL lifetime (seconds).
RECEIPT_MAX_BYTES=5242880
RECEIPT_URL_TTL_SECONDS=600

# Phones (comma-separated, 09xxxxxxxxx) that are platform owners/admins (Liro semantics)
ADMIN_PHONES=

# ── SMS (Kavenegar) ──────────────────────────────────────────────────────────
# SMS_PROVIDER: kavenegar | console   (console = dev/tests, codes are logged + kept in an in-memory outbox)
# User OTP delivery goes through the Supabase Auth Send SMS hook (which calls
# this same provider); admin OTP uses it directly.
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
# Verify Lookup template/pattern names as configured in the Kavenegar panel.
# token = the value substituted into the template's %token% placeholder.
KAVENEGAR_TEMPLATE=                 # OTP template (Liro env name)
KAVENEGAR_TEMPLATE_PACKAGE_ACTIVATED=
KAVENEGAR_TEMPLATE_EXPIRY_WARNING=
KAVENEGAR_TEMPLATE_EXPIRED=
KAVENEGAR_TEMPLATE_ORDER_REJECTED=
# Non-prod safety valve: if set, real SMS goes ONLY to these numbers (comma-separated)
SMS_ALLOWLIST=

# ── Shop / card-to-card (defaults; editable later from the admin panel) ──────
SHOP_CARD_NUMBER=
SHOP_CARD_HOLDER=
SHOP_CARD_BANK=

# ── Token economy defaults (admin-editable in settings) ─────────────────────
# Base (multiplier = 1) tokens granted per 1 USD of pack value
TOKENS_PER_USD=5000000

# ── Admin panel: receipts + AI analyst (PRD §6) ──────────────────────────────
# Service-role key (server-side only): mints signed URLs for claim receipts
# in the private Storage bucket. SUPABASE_URL is derived from
# SUPABASE_AUTH_URL when left empty.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Claim receipt images live in the PRIVATE Storage bucket `receipts`
# (created by migration 3; the name is part of the storage contract).
# Local development only: directory the receipt object keys are read from
RECEIPTS_DIR=
# AI analyst chat (admin, on-demand only). Falls back to UPSTREAM_* when empty.
ANALYST_BASE_URL=
ANALYST_API_KEY=
ANALYST_MODEL=deepseek-v4.1-flash

# ── Upstream LLM gateway (server-side only, never logged, never returned) ────
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=

# ── Limits ───────────────────────────────────────────────────────────────────
MAX_DEVICES=2
CHAT_RATE_PER_MIN=60
CHAT_MAX_CONCURRENT=3
